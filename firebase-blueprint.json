{
  "entities": {
    "students": {
      "title": "Students",
      "description": "Student user accounts and enrolled courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "password": { "type": "string" },
        "grade": { "type": "string" },
        "governorate": { "type": "string" },
        "deviceFingerprint": { "type": "string" },
        "registeredAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "isBlocked": { "type": "boolean" },
        "registeredDevices": { "type": "array", "items": { "type": "string" } },
        "maxDevicesAllowed": { "type": "number" },
        "enrolledCourseIds": { "type": "array", "items": { "type": "string" } },
        "unlockedPdfIds": { "type": "array", "items": { "type": "string" } },
        "courseExpiryDates": { "type": "object" }
      },
      "required": ["id", "name", "phone", "grade"]
    },
    "courses": {
      "title": "Courses",
      "description": "Educational courses with units and video lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructorName": { "type": "string" },
        "grade": { "type": "string" },
        "thumbnail": { "type": "string" },
        "price": { "type": "number" },
        "validityDays": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "units": { "type": "array" }
      },
      "required": ["id", "title", "grade"]
    },
    "exams": {
      "title": "Quizzes & Exams",
      "description": "Quizzes and exams created by instructor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "courseId": { "type": "string" },
        "grade": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "passingPercentage": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "type"]
    },
    "attempts": {
      "title": "Exam Attempts",
      "description": "Student quiz/exam submission results",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" },
        "timeTakenSeconds": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "examId", "score"]
    },
    "progress": {
      "title": "Lesson Progress",
      "description": "Student lesson view status and completion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "courseId": { "type": "string" },
        "lessonId": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "lastViewedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "lessonId"]
    },
    "activationCodes": {
      "title": "Activation Codes",
      "description": "Subscription and access activation keys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "targetId": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "targetId", "isUsed"]
    },
    "pdfs": {
      "title": "PDF Materials",
      "description": "Educational PDF books and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "grade": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "grade"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "Platform announcements and alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message"]
    },
    "settings": {
      "title": "Platform Settings",
      "description": "Platform global configuration and instructor branding",
      "type": "object",
      "properties": {
        "platformName": { "type": "string" },
        "instructorName": { "type": "string" },
        "instructorTitle": { "type": "string" },
        "instructorPhotoUrl": { "type": "string" }
      }
    }
  }
}
