rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'admin' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public / Student readable curriculum & metadata
    match /app_data/wikifizya_db_courses_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_data/wikifizya_db_settings_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_data/wikifizya_db_pdf_categories_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_data/wikifizya_db_pdf_files_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_data/wikifizya_db_notifications_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quizzes & Exams: Read for students, write only for Admin
    match /app_data/wikifizya_db_exams_v4 {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboard & Weekly Challenge: Read public, write admin or authenticated student
    match /app_data/wikifizya_db_leaderboard_v4 {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Activation Keys: Strictly Admin Only to prevent code harvesting
    match /app_data/wikifizya_db_activation_keys_v4 {
      allow read, write: if isAdmin();
    }

    // Student Accounts Data: Protected access
    match /app_data/wikifizya_db_students_v4 {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // Progress and Exam Attempts
    match /app_data/wikifizya_db_lesson_progress_v4 {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    match /app_data/wikifizya_db_exam_attempts_v4 {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // Student Specific Documents
    match /students/{studentId} {
      allow read, write: if isOwner(studentId) || isAdmin();
      
      match /progress/{lessonId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }
      
      match /attempts/{attemptId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }

      match /weakness_profile/{profileId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }
    }

    // Admin Documents
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default Deny All other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

