# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ADMIN_JWT_SECRET: Optional secret key for signing admin authentication tokens.
# If not provided, a random secure string will be generated automatically at server start.
ADMIN_JWT_SECRET=

# ADMIN_PIN: Optional custom PIN for admin dashboard access.
# Default if not set: WikiPhys@9988#Master
ADMIN_PIN=
